###############################################################################
# Crypto Intelligence Dashboard — environment template
#
# Copy to `.env` and fill in what you have. The platform is designed to run
# with ZERO API keys: every connector declares whether it needs credentials,
# and the registry disables key-gated connectors instead of failing at boot.
#
# Validated at startup by `@cid/platform` (packages/platform/src/env.ts).
# Anything marked REQUIRED must be present or the process refuses to start.
###############################################################################

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# `pretty` for human-readable dev logs, `json` for production log shipping.
LOG_FORMAT=pretty

# ─── Datastores (REQUIRED) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://cid:cid@localhost:5432/cid?schema=public
REDIS_URL=redis://localhost:6379

# Integration tests TRUNCATE every table, so they refuse to run against a
# database whose name does not look disposable. Set this to opt in explicitly.
TEST_DATABASE_URL=postgresql://cid:cid@localhost:5432/cid_test?schema=public

# ─── Web app ─────────────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated origins allowed to hit the API. `*` disables the check.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for the internal worker -> web push endpoint and for the
# /api/admin/* routes. Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# ─── Local LLM ───────────────────────────────────────────────────────────────
# provider: ollama | lmstudio | openai-compatible | llamacpp | vllm | null
# `null` disables AI enrichment entirely — ingestion and charts still work,
# events are simply stored without summaries or scores.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
# Only needed by OpenAI-compatible servers that enforce auth (vLLM, LM Studio
# with an API key, LiteLLM proxies, ...).
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=120000
# Max concurrent LLM requests. Local single-GPU boxes should stay at 1-2.
LLM_CONCURRENCY=2

# Embeddings for semantic search. Dimension MUST match the pgvector column;
# changing it requires a migration (see docs/DEVELOPMENT.md#changing-embedding-dims).
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ─── Scheduler cadences (milliseconds) ───────────────────────────────────────
# Per-domain polling intervals. Every collector is independently scheduled and
# retried; see packages/worker/src/scheduler for the backoff policy.
INTERVAL_MARKET_MS=10000
INTERVAL_DERIVATIVES_MS=30000
INTERVAL_NEWS_MS=60000
INTERVAL_SOCIAL_MS=60000
INTERVAL_ONCHAIN_MS=60000
INTERVAL_GITHUB_MS=60000
INTERVAL_GOVERNANCE_MS=300000
INTERVAL_TOKENOMICS_MS=900000
INTERVAL_ENRICHMENT_MS=15000

# Global ingestion kill switch — useful when developing UI against seed data.
INGESTION_ENABLED=true

# ─── Market data providers ───────────────────────────────────────────────────
# CoinGecko works keyless on the public tier (~30 req/min). A demo or pro key
# raises the ceiling and is strongly recommended for >50 tracked coins.
COINGECKO_API_KEY=
COINGECKO_API_TIER=public
COINMARKETCAP_API_KEY=

# CEX public market data needs no keys. Keys only unlock private endpoints,
# which this platform never calls — it is read-only by design.
BINANCE_API_BASE=https://api.binance.com
BYBIT_API_BASE=https://api.bybit.com
OKX_API_BASE=https://www.okx.com
KRAKEN_API_BASE=https://api.kraken.com
COINBASE_API_BASE=https://api.exchange.coinbase.com
KUCOIN_API_BASE=https://api.kucoin.com
MEXC_API_BASE=https://api.mexc.com
HYPERLIQUID_API_BASE=https://api.hyperliquid.xyz

# DEX / DeFi (all keyless)
DEXSCREENER_API_BASE=https://api.dexscreener.com
GECKOTERMINAL_API_BASE=https://api.geckoterminal.com/api/v2
DEFILLAMA_API_BASE=https://api.llama.fi

# ─── On-chain data ───────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
# Etherscan V2 multichain endpoint — one key covers 50+ chains.
ETHERSCAN_API_BASE=https://api.etherscan.io/v2/api
SOLSCAN_API_KEY=
BLOCKSCOUT_API_BASE=https://eth.blockscout.com/api/v2
ARKHAM_API_KEY=
NANSEN_API_KEY=
DUNE_API_KEY=
GLASSNODE_API_KEY=
SANTIMENT_API_KEY=
INTOTHEBLOCK_API_KEY=

# Whale-alert threshold in USD for promoting a transfer to a timeline event.
WHALE_THRESHOLD_USD=1000000

# ─── Social ──────────────────────────────────────────────────────────────────
# X/Twitter API v2 bearer token. Without it the X connector stays disabled;
# Nitter-style scraping is deliberately NOT implemented (ToS + reliability).
X_BEARER_TOKEN=
# Reddit works read-only without credentials but is aggressively rate limited.
# Supplying an OAuth app raises limits substantially.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=cid/1.0 (crypto-intelligence-dashboard)
YOUTUBE_API_KEY=
FARCASTER_HUB_URL=https://hub.pinata.cloud
NEYNAR_API_KEY=
LENS_API_BASE=https://api-v2.lens.dev
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Unauthenticated: 60 req/h. A classic PAT with `public_repo` gives 5000 req/h.
GITHUB_TOKEN=

# ─── Notifications ───────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
# Extra fan-out target for every fired alert.
GENERIC_WEBHOOK_URL=

# ─── Limits & retention ──────────────────────────────────────────────────────
# Requests/minute per IP against the public API surface.
RATE_LIMIT_RPM=300
# Redis cache TTL for provider responses, in seconds.
CACHE_TTL_SECONDS=30
# Max coins the scheduler will actively poll. Watchlist coins take priority.
MAX_TRACKED_COINS=500
# Retention for raw high-frequency market snapshots. Rollups are kept forever;
# 0 disables pruning (append-only, never overwrite — see docs/ARCHITECTURE.md).
MARKET_SNAPSHOT_RETENTION_DAYS=90
